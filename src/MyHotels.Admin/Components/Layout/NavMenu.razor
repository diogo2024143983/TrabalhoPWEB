@using Microsoft.AspNetCore.Components.Authorization
@using MyHotels.Domain.Identity

<div class="nav-brand">
    <a href="">MyHotels Admin</a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Início</NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="sobre">Sobre</NavLink>
        </div>

        <AuthorizeView Roles="@($"{AppRoles.Administrador},{AppRoles.Funcionario}")">
            <Authorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="hoteis">Hotéis</NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="categorias">Categorias</NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="modos">Modos de disponibilização</NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="alojamentos">Alojamentos</NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="reservas">Reservas</NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="clientes">Clientes</NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="fornecedores">Fornecedores</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@AppRoles.Administrador">
            <Authorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="funcionarios">Funcionários</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>
