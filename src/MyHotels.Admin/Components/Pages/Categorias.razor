@page "/categorias"
@attribute [Authorize(Policy = "Staff")]
@using Microsoft.EntityFrameworkCore
@using MyHotels.Domain.Entities
@using MyHotels.Infrastructure.Data
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IImagensService Imagens
@inject IMensagensService Mensagens
@rendermode InteractiveServer

<PageTitle>Categorias</PageTitle>
<h1>Categorias de alojamento</h1>

<Aviso />

<div class="toolbar">
    <input @bind="_search" @bind:event="oninput" placeholder="Filtrar por nome" />
    <button class="btn btn-primary" @onclick="StartCreate">Nova categoria</button>
</div>

@if (_editing is not null)
{
    <EditForm Model="_editing" OnValidSubmit="SaveAsync" FormName="categoria-form">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label>Nome</label>
            <InputText @bind-Value="_editing.Name" class="form-control" />
        </div>
        <div class="form-group">
            <label>Descrição</label>
            <InputTextArea @bind-Value="_editing.Description" class="form-control" />
        </div>
        <div class="form-group">
            <label>Fotografia (.png, .jpg, máx. 500 KB)</label>
            <InputFile OnChange="CarregarImagemAsync" accept=".png,.jpg,.jpeg" class="form-control" />
            <img src="@Imagens.Src(_editing.Image, _editing.ImagePath)"
                 alt="Pré-visualização"
                 style="max-height: 80px; margin-top: 8px; border-radius: 4px; border: 1px solid #ddd;" />
        </div>
        <label><InputCheckbox @bind-Value="_editing.IsActive" /> Ativa</label>
        <div class="toolbar">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <button type="button" class="btn" @onclick="CancelEdit">Cancelar</button>
        </div>
    </EditForm>
}

<table class="table">
    <thead>
        <tr>
            <th>Foto</th>
            <th><button class="link-btn" @onclick='() => SortBy("name")'>Nome</button></th>
            <th>Descrição</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Filtered())
        {
            <tr>
                <td>
                    <img src="@Imagens.Src(item.Image, item.ImagePath)"
                         alt="@item.Name"
                         style="width: 64px; height: 48px; object-fit: cover; border-radius: 4px;" />
                </td>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@(item.IsActive ? "Ativa" : "Inativa")</td>
                <td class="actions">
                    <button class="btn" @onclick="() => StartEdit(item)">Editar</button>
                    <button class="btn" @onclick="() => ToggleActiveAsync(item)">@(item.IsActive ? "Inativar" : "Ativar")</button>
                    <button class="btn btn-danger" @onclick="() => DeleteAsync(item)">Apagar</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<AccommodationCategory> _items = [];
    private AccommodationCategory? _editing;
    private string _search = string.Empty;
    private string _sort = "name";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _items = await db.AccommodationCategories
            .AsNoTracking()
            .OrderBy(x => x.Name)
            .ToListAsync();
    }

    private IEnumerable<AccommodationCategory> Filtered()
    {
        var query = _items.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_search))
        {
            query = query.Where(x => x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));
        }

        return _sort == "name"
            ? query.OrderBy(x => x.Name)
            : query.OrderByDescending(x => x.Name);
    }

    private void SortBy(string field) => _sort = field;

    private void StartCreate()
    {
        _editing = new AccommodationCategory { Name = string.Empty, IsActive = true };
    }

    private void StartEdit(AccommodationCategory item)
    {
        _editing = new AccommodationCategory
        {
            Id = item.Id,
            Name = item.Name,
            Description = item.Description,
            ImagePath = item.ImagePath,
            Image = item.Image,
            IsActive = item.IsActive
        };
    }

    private void CancelEdit() => _editing = null;

    private async Task CarregarImagemAsync(InputFileChangeEventArgs e)
    {
        if (_editing is null) return;

        var ficheiro = e.File;
        var erro = Imagens.Valida(ficheiro.Name, ficheiro.Size);
        if (erro is not null)
        {
            Mensagens.Erro(erro);
            return;
        }

        await using var stream = ficheiro.OpenReadStream(Imagens.TamanhoMax);
        _editing.Image = await Imagens.LerBytesAsync(stream);
        _editing.ImagePath = ficheiro.Name;
    }

    private async Task SaveAsync()
    {
        if (_editing is null) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (_editing.Id == 0)
            {
                db.AccommodationCategories.Add(_editing);
            }
            else
            {
                db.AccommodationCategories.Update(_editing);
            }

            await db.SaveChangesAsync();
            _editing = null;
            Mensagens.Sucesso("Categoria guardada com sucesso.");
            await ReloadAsync();
        }
        catch (DbUpdateException)
        {
            Mensagens.Erro("Não foi possível gravar a categoria: verifica se já existe uma categoria com esse nome.");
        }
    }

    private async Task ToggleActiveAsync(AccommodationCategory item)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.AccommodationCategories.FindAsync(item.Id);
        if (entity is null) return;
        entity.IsActive = !entity.IsActive;
        await db.SaveChangesAsync();
        await ReloadAsync();
    }

    private async Task DeleteAsync(AccommodationCategory item)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var inUse = await db.Accommodations.AnyAsync(x => x.CategoryId == item.Id);
            if (inUse)
            {
                Mensagens.Erro("Não é possível apagar: existem alojamentos associados a esta categoria.");
                return;
            }

            var entity = await db.AccommodationCategories.FindAsync(item.Id);
            if (entity is null) return;
            db.AccommodationCategories.Remove(entity);
            await db.SaveChangesAsync();
            Mensagens.Sucesso("Categoria apagada com sucesso.");
            await ReloadAsync();
        }
        catch (DbUpdateException)
        {
            Mensagens.Erro("Não foi possível apagar a categoria porque existem registos associados.");
        }
    }
}